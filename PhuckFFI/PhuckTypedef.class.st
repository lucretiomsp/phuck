"
I am a SharedPool generated by pharo-cig from phuck.h.
I map the C type names used in the function signatures (phuck_t, phuck_req_t, int64_t, ...) to their uFFI types, so that LibPhuck''s ffiCall: declarations compile.
Classes that call libphuck include me as a pool. Regenerating with pharo-cig overwrites me.'.
"
Class {
	#name : 'PhuckTypedef',
	#superclass : 'SharedPool',
	#classVars : [
		'__float128',
		'bool',
		'int16_t',
		'int32_t',
		'int64_t',
		'int8_t',
		'phuck',
		'phuck_req',
		'phuck_req_t',
		'phuck_t',
		'pid_t',
		'time_t',
		'uint16_t',
		'uint32_t',
		'uint64_t',
		'uint8_t',
		'uintptr_t'
	],
	#category : 'PhuckFFI-Library',
	#package : 'PhuckFFI',
	#tag : 'Library'
}

{ #category : 'class initialization' }
PhuckTypedef class >> initialize [

	uint16_t := #uint16.
	uint64_t := #uint64.
	uint8_t := #uint8.
	int32_t := #int32.
	uint32_t := #uint32.
	time_t := #int.
	pid_t := #int.
	__float128 := #float128.
	int8_t := #int8.
	int16_t := #int16.
	int64_t := #int64.
	bool := #Boolean.
	uintptr_t := #'void *'.
	phuck := Phuck.
	phuck_t := Phuck.
	phuck_req := PhuckReq.
	phuck_req_t := PhuckReq
]
