"
I am the uFFI binding to libphuck, the C shim that embeds the ChucK audio language (VM, compiler, UGens, realtime audio) in one shared library.

I am generated by pharo-cig from phuck.h: each instance method is one C function, named as in C, e.g.
```language=Pharo
	LibPhuck uniqueInstance phuck_version.
	LibPhuck uniqueInstance phuck_set_floatCk: ck name: ''freq'' v: 440.0.
```
I look for the library in <image dir>/phuckLibraries (libphuck.dylib, libphuck.so, phuck.dll).
Do not use me directly in application code: use Phuck, which handles setup order, async reads and buffers.
Regenerating with pharo-cig overwrites me.'.
"
Class {
	#name : 'LibPhuck',
	#superclass : 'FFILibrary',
	#pools : [
		'PhuckTypedef'
	],
	#category : 'PhuckFFI-Library',
	#package : 'PhuckFFI',
	#tag : 'Library'
}

{ #category : 'accessing - platform' }
LibPhuck >> macLibraryName [

	^ FFIMacLibraryFinder new
		userPaths: { (FileLocator imageDirectory / 'phuckLibraries') fullName };
		findLibrary: 'libphuck.dylib'
]

{ #category : 'public - phuck' }
LibPhuck >> phuck_audio_startCk: ck bufferFrames: bufferFrames [
	"/* audio B: shim owns a realtime device (RtAudio) that calls ChucK::run */"

	^ self ffiCall: #(int phuck_audio_start(phuck_t* ck, int bufferFrames))
]

{ #category : 'public - phuck' }
LibPhuck >> phuck_audio_stop: ck [

	self ffiCall: #(void phuck_audio_stop(phuck_t* ck))
]

