"
I am a trait generated by pharo-cig.
I answer #ffiLibraryName with LibPhuck, so every generated class that uses me (the opaque handles for phuck_t and phuck_req_t) resolves its FFI calls against libphuck.
Regenerating with pharo-cig overwrites me.
"
Trait {
	#name : 'LibTPhuck',
	#category : 'PhuckFFI-Library',
	#package : 'PhuckFFI',
	#tag : 'Library'
}

{ #category : 'library path' }
LibTPhuck classSide >> ffiLibraryName [

	^ LibPhuck
]

{ #category : 'library path' }
LibTPhuck >> ffiLibraryName [

	^ LibPhuck
]
